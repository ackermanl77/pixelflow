__pycache__/
*.pyc
.venv/
venv/
outputs/*
!outputs/.gitkeep
uploads/*
!uploads/.gitkeep
.pytest_cache/

# Runtime data written next to the app (backend/paths.py): the rotating log and persisted history.
/logs/
/history.jsonl
/history.jsonl.tmp

# Build & release output
build-release/
# A separate venv to build releases from without touching .venv (docs/BUILD.md).
/build-venv/
dist-release/
dist/
build/
PixelFlow-*-Windows/
PixelFlow-*-Windows.zip
PixelFlow-*-Windows.7z
PixelFlow-*-Windows.7z.sha256
# Split volumes (.7z.001, .002, ...) of an archive over -MaxAssetBytes (scripts/build_release.ps1).
PixelFlow-*-Windows.7z.[0-9][0-9][0-9]
# Fixed-name mirror of the current PixelFlow-<version>-Windows/ build output (see
# scripts/build_release.ps1) -- always the latest build, so PixelFlow.exe has one stable place.
/release/
# Downloaded/extracted third-party runtime bundled into releases (see scripts/build_release.ps1).
# Anchored to the root only -- frontend/vendor/ holds vendored litegraph.js source, not this cache.
/vendor/

# User models (multi-GB checkpoints/LoRAs), saved workflows and Preview Image's
# throwaway files (backend/paths.py). Never commit these.
/models/
/workflows/*
!/workflows/.gitkeep
/temp/
/settings.json

# Stamped by scripts/build_release.ps1 during a build (backend/config.py reads it).
/backend/_version.py

# Node dev tooling (package.json): dependencies, and Playwright output/browsers
# (installed under node_modules with PLAYWRIGHT_BROWSERS_PATH=0).
/node_modules/
/test-results/
/playwright-report/

graphify-out/
